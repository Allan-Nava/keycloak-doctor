# Built binary at the repo root only — anchored with a leading slash so it does
# NOT also match the cmd/keycloak-doctor/ package directory.
/keycloak-doctor
/dist/
.DS_Store
cover.out

# Realm exports are credential material: never let one into the history by
# accident. The committed fixtures under testdata/ are explicit exceptions.
*-realm-export.json
*realm-export*.json
!testdata/*.json

# Per-developer Claude Code permissions — machine-local, never shared.
.claude/settings.local.json

# graphify knowledge graph: derived from the sources, rebuilt with
# `graphify update .`.
graphify-out/
